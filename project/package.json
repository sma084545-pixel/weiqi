{
  "name": "go-club",
  "version": "0.20.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/finalize-offline.mjs && vite build --config vite.server.config.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "schema:types": "node scripts/generate-types.mjs",
    "schema:check": "node scripts/generate-types.mjs --check",
    "validate:content": "node --import tsx scripts/validate-content.ts",
    "check": "pnpm schema:check && pnpm test && pnpm validate:content && pnpm validate:t09 && pnpm test:t09-grader && pnpm test:t14 && pnpm test:t15 && pnpm validate:t17 && pnpm verify:merge-a && pnpm verify:t16-freeze && pnpm build && pnpm test:t16-refresh && pnpm build:engine && pnpm test:engine-build && pnpm test:engine-capacity",
    "test:browser": "playwright test --workers=1 && pnpm test:online-browser",
    "build:engine": "vite build --config vite.engine.config.ts && tsc -p tsconfig.engine.json && node scripts/finish-engine-build.mjs",
    "test:engine": "vitest run tests/t01",
    "test:engine-build": "node scripts/engine-smoke.mjs && tsc -p tsconfig.engine-smoke.json",
    "test:engine-capacity": "node scripts/engine-capacity.mjs",
    "validate:t09": "node --import tsx content/tools/validate.mjs",
    "test:t09-grader": "node content/tools/test-grade.mjs",
    "test:t10": "vitest run tests/t10",
    "test:t10-browser": "playwright test tests/browser/t10.spec.ts --workers=1",
    "test:t11": "vitest run tests/t11",
    "test:t11-browser": "playwright test tests/browser/t11.spec.ts --workers=1",
    "test:t12": "vitest run tests/t12",
    "test:t12-browser": "playwright test tests/browser/t12.spec.ts --workers=1",
    "verify:merge-a": "node scripts/verify-merge-a.mjs",
    "test:t13": "vitest run tests/t13",
    "test:t13-browser": "playwright test tests/browser/t13.spec.ts --workers=1",
    "test:t14": "vitest run tests/t14",
    "test:t14-browser": "playwright test tests/browser/t14.spec.ts --workers=1",
    "test:t15": "vitest run tests/t15",
    "test:t15-browser": "playwright test tests/browser/t15.spec.ts --workers=1",
    "verify:freeze": "node scripts/verify-content-freeze.mjs",
    "test:t16": "vitest run tests/t16",
    "test:t16-browser": "playwright test tests/browser/t16.spec.ts --workers=1",
    "test:t16-refresh": "node scripts/verify-t16-refresh.mjs",
    "verify:t16-freeze": "node scripts/verify-t16-freeze-preservation.mjs",
    "test:t17": "vitest run tests/t17",
    "test:t17-browser": "playwright test tests/browser/t17.spec.ts --workers=1",
    "validate:t17": "node --import tsx scripts/validate-t17.ts",
    "test:history": "vitest run tests/history",
    "test:history-browser": "playwright test tests/browser/history.spec.ts --workers=1",
    "build:server": "vite build --config vite.server.config.ts",
    "start": "node dist-server/server.mjs",
    "dev:online": "node --import tsx server/index.ts",
    "test:online": "vitest run tests/online",
    "test:online-browser": "playwright test --config=playwright.online.config.ts --workers=1",
    "test:pages": "vitest run tests/pages",
    "build:pages": "node scripts/build-public-site.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "json-schema-to-typescript": "16.0.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "packageManager": "pnpm@11.19.0"
}
