          "uniqueItems": true
        },
        "outcome": {
          "enum": [
            "continue",
            "success",
            "failure",
            "unknown"
          ]
        },
        "terminalStatus": {
          "anyOf": [
            {
              "$ref": "#/$defs/TerminalStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "explanation": {
          "type": "string",
          "maxLength": 20000
