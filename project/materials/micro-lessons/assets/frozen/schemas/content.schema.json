          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "number"
            },
            "value": {
              "type": "number"
            },
            "explanation": {
              "type": "string",
              "maxLength": 20000
            }
          },
          "required": [
            "type",
            "value",
            "explanation"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "region-labels"
            },
            "labels": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Ownership"
              }
            },
            "explanation": {
              "type": "string",
              "maxLength": 20000
            }
          },
          "required": [
            "type",
            "labels",
            "explanation"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "reason-choice"
            },
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "optionId": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,79}$"
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 20000
                  }
                },
                "required": [
                  "optionId",
                  "text"
                ],
                "additionalProperties": false
              },
              "minItems": 2
            },
            "acceptedOptionIds": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,79}$"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "explanation": {
              "type": "string",
              "maxLength": 20000
            }
          },
          "required": [
            "type",
            "options",
            "acceptedOptionIds",
            "explanation"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "open-text"
            },
            "criteria": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "minItems": 1
            },
            "sampleConsiderations": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 20000
              }
            },
            "automaticVerdict": {
              "const": false
            }
          },
          "required": [
            "type",
            "criteria",
            "sampleConsiderations",
            "automaticVerdict"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "move-tree"
            },
            "rootNodeId": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,79}$"
            },
            "nodes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/TreeNode"
              },
              "minItems": 1
            },
            "uncoveredPolicy": {
              "const": "unknown"
            },
            "uniquenessClaim": {
              "type": "boolean"
            },
            "uniquenessEvidence": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          },
          "required": [
            "type",
            "rootNodeId",
            "nodes",
            "uncoveredPolicy",
            "uniquenessClaim",
            "uniquenessEvidence"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Response": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
