          "maxLength": 20000
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "viewport": {
          "anyOf": [
            {
              "$ref": "#/$defs/Viewport"
            },
            {
              "type": "null"
            }
          ]
