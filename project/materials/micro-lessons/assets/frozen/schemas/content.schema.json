          "enum": [
            "B",
            "W",
            "neutral",
            "unknown"
          ]
        }
      },
      "required": [
        "at",
        "owner"
      ],
      "additionalProperties": false
    },
    "TerminalStatus": {
      "enum": [
        "verified-alive",
        "verified-dead",
        "unsettled",
        "unknown"
      ]
    },
    "TreeNode": {
      "type": "object",
      "properties": {
        "nodeId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,79}$"
        },
        "move": {
          "anyOf": [
            {
              "$ref": "#/$defs/Move"
            },
            {
              "type": "null"
            }
          ]
        },
        "children": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,79}$"
