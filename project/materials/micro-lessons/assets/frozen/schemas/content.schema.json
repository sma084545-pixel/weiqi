{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:go-club:schema:content:1",
  "title": "ContentDocument",
  "oneOf": [
    {
      "$ref": "#/$defs/Position"
    },
    {
      "$ref": "#/$defs/MoveDocument"
    },
    {
      "$ref": "#/$defs/GameState"
    },
    {
      "$ref": "#/$defs/MarkerDocument"
    },
    {
      "$ref": "#/$defs/SetupDocument"
    },
    {
      "$ref": "#/$defs/Lesson"
    },
    {
      "$ref": "#/$defs/Puzzle"
    },
    {
      "$ref": "#/$defs/TerminalFixture"
    },
    {
      "$ref": "#/$defs/Feedback"
    },
    {
      "$ref": "#/$defs/ContentBundle"
    }
  ],
  "$defs": {
    "Coord": {
      "type": "object",
      "properties": {
        "row": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18
        },
        "col": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18
        }
      },
      "required": [
        "row",
        "col"
      ],
      "additionalProperties": false
    },
    "Color": {
      "enum": [
        "B",
        "W"
      ]
    },
    "StoneValue": {
      "enum": [
        "B",
        "W",
        null
      ]
    },
    "Size": {
      "enum": [
        5,
        9,
        13,
        19
      ]
    },
    "Stone": {
      "type": "object",
      "properties": {
        "row": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18
        },
        "col": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18
        },
        "color": {
          "$ref": "#/$defs/Color"
        }
      },
      "required": [
        "row",
        "col",
        "color"
      ],
      "additionalProperties": false
    },
    "Board": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/StoneValue"
        },
        "minItems": 5,
        "maxItems": 19
      },
      "minItems": 5,
      "maxItems": 19
    },
    "Move": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "place"
            },
            "color": {
              "$ref": "#/$defs/Color"
            },
            "at": {
              "$ref": "#/$defs/Coord"
            }
          },
          "required": [
            "type",
            "color",
            "at"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "pass"
            },
            "color": {
              "$ref": "#/$defs/Color"
            }
          },
          "required": [
            "type",
            "color"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "resign"
            },
            "color": {
              "$ref": "#/$defs/Color"
            }
          },
          "required": [
            "type",
            "color"
          ],
          "additionalProperties": false
        }
      ]
    },
    "SetupOperation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "setup-set"
            },
            "at": {
              "$ref": "#/$defs/Coord"
            },
            "color": {
              "$ref": "#/$defs/Color"
            }
          },
          "required": [
            "type",
            "at",
            "color"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "setup-erase"
            },
            "at": {
              "$ref": "#/$defs/Coord"
            }
          },
          "required": [
            "type",
            "at"
          ],
          "additionalProperties": false
        }
      ]
    },
    "History": {
      "type": "object",
      "properties": {
        "layouts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(5|9|13|19)\\|[.BW]+$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "layouts"
      ],
      "additionalProperties": false
    },
    "Position": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,79}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "rulesetId": {
          "const": "GO-CLUB-AREA-1"
        },
        "kind": {
          "const": "Position"
        },
        "size": {
          "$ref": "#/$defs/Size"
        },
        "stones": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Stone"
          },
          "maxItems": 361
        },
        "toPlay": {
          "$ref": "#/$defs/Color"
        },
        "historyPolicy": {
          "enum": [
            "fresh-setup",
            "recorded"
          ]
        },
        "history": {
          "anyOf": [
            {
              "$ref": "#/$defs/History"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "revision",
        "rulesetId",
        "kind",
        "size",
        "stones",
        "toPlay",
        "historyPolicy",
        "history"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "historyPolicy": {
                "const": "fresh-setup"
              }
            }
          },
          "then": {
            "properties": {
              "history": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "history": {
                "$ref": "#/$defs/History"
              }
            }
          }
        }
      ]
    },
    "Marker": {
      "type": "object",
      "properties": {
        "markerId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,79}$"
        },
        "type": {
          "enum": [
            "target",
            "liberty",
            "last-move",
            "sequence",
            "annotation",
            "ownership"
          ]
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Coord"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "label": {
          "type": "string",
          "maxLength": 20000
        },
        "owner": {
          "anyOf": [
            {
              "enum": [
                "B",
                "W",
                "neutral"
              ]
            },
            {
              "type": "null"
