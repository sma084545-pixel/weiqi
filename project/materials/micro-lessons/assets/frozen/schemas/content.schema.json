        },
        "moveLegality": {
          "anyOf": [
            {
              "$ref": "#/$defs/Check"
            },
            {
              "type": "null"
            }
          ]
        },
        "solutionChecked": {
          "anyOf": [
            {
              "$ref": "#/$defs/Check"
            },
            {
              "type": "null"
            }
          ]
        },
        "externalReferenceChecked": {
          "anyOf": [
            {
              "$ref": "#/$defs/Check"
            },
            {
              "type": "null"
            }
          ]
        },
        "modelChecked": {
          "anyOf": [
            {
              "$ref": "#/$defs/Check"
            },
            {
              "type": "null"
            }
          ]
        },
        "humanReviewed": {
          "anyOf": [
            {
              "$ref": "#/$defs/HumanReview"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "structure",
        "moveLegality",
        "solutionChecked",
        "externalReferenceChecked",
        "modelChecked",
        "humanReviewed"
      ],
      "additionalProperties": false
    },
    "Source": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "original",
            "adapted",
            "reference"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "url": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^https://[^\\s]+$",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "accessedAt": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "type": "string",
          "maxLength": 20000
        }
      },
      "required": [
        "type",
        "title",
        "url",
        "accessedAt",
        "note"
      ],
      "additionalProperties": false
    },
    "ContentRef": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,79}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
