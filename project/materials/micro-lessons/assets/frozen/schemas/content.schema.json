          ]
        }
      },
      "required": [
        "markerId",
        "type",
        "points",
        "label",
        "owner"
      ],
      "additionalProperties": false
    },
    "Check": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "partial",
            "not-applicable"
          ]
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "checkedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "minItems": 1
        }
      },
      "required": [
        "status",
        "method",
        "checkedAt",
        "evidence"
      ],
      "additionalProperties": false
    },
    "HumanReview": {
      "type": "object",
      "properties": {
        "reviewer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "reviewerRole": {
          "const": "human"
        },
        "checkedAt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "scope": {
          "type": "string",
          "maxLength": 20000
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "minItems": 1
        }
      },
      "required": [
        "reviewer",
        "reviewerRole",
        "checkedAt",
        "scope",
        "evidence"
      ],
      "additionalProperties": false
    },
    "Validation": {
      "type": "object",
      "properties": {
        "structure": {
