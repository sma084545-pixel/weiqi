# Server only. Public origin has no /weiqi/ path. No secrets are needed.
PUBLIC_ORIGIN=https://sma084545-pixel.github.io
KATAGO_MAX_VISITS=64
PORT=10000
# Fixed defaults inside Docker; change only as a server operator, not in HTTP requests:
KATAGO_PATH=/opt/katago/katago
KATAGO_MODEL=/opt/katago/model.bin.gz
KATAGO_CONFIG=/app/analysis-engine/analysis.cfg
APP_ROOT=/app
# Frontend build-time public address, set ONLY after actual service URL is confirmed:
# VITE_KATAGO_API_ORIGIN=https://ACTUAL-SERVICE.onrender.com
