      "title": "手筋与局部技巧",
      "english": "Tesuji",
      "goal": "先找弱点，再计算打吃、切断和提子。",
      "question": "看起来送一子，为什么反而能提三子？",
      "introSceneId": "ADV-08-04",
      "concepts": [
        {
          "id": "scan",
          "title": "先扫描，不是见子就打吃",
          "text": "Atari → Cut → Capture → Weakness：观察威胁、切点、可提棋，也看自己的弱点。",
          "sceneId": "ADV-08-01",
          "takeaway": "先观察，再比较；题目结论只在给定目标和条件下成立。"
        },
        {
          "id": "ladder",
          "title": "征子：沿完整盘面看",
          "text": "每次从正确一侧打吃，让对方在延长后仍受限制；方向错误或外援接上，原结论可变。",
          "sceneId": "ADV-08-02",
          "takeaway": "先观察，再比较；题目结论只在给定目标和条件下成立。"
        },
        {
          "id": "net",
          "title": "枷：先封逃路",
          "text": "枷不必每手打吃。先限制出口，再核查不同逃法。",
          "sceneId": "ADV-08-03",
          "takeaway": "先观察，再比较；题目结论只在给定目标和条件下成立。"
        },
        {
          "id": "snap",
          "title": "倒扑：提后重新数气",
          "text": "看似送子，可能让对方提后整块只剩一气。先提敌再查己气；与劫回提分别检查。",
          "sceneId": "ADV-08-04",
          "takeaway": "先观察，再比较；题目结论只在给定目标和条件下成立。"
        }
      ],
