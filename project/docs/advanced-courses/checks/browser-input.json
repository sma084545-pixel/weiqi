      "kind": "CourseLesson",
      "number": 7,
      "title": "好形与坏形",
      "english": "Shape & Efficiency",
      "goal": "用更少的棋完成连接、安全与发展的任务。",
      "question": "同样三颗棋，紧密是否就更高效？",
      "introSceneId": "ADV-07-01",
      "concepts": [
        {
          "id": "shape",
          "title": "位置关系与效率",
          "text": "连接、气、发展空间和投入的子数一起看。7气与8气是具体事实，不等于自动判活。",
          "sceneId": "ADV-07-01",
          "takeaway": "先观察，再比较；题目结论只在给定目标和条件下成立。"
        },
        {
          "id": "patterns",
          "title": "尖、飞、跳与虎",
          "text": "尖是斜一步；小飞横二竖一，飞是斜向展开的泛称；一间跳隔一点；虎口三面围护。点名称可用来讨论，能否连接仍须验算。",
          "sceneId": "ADV-07-05",
          "takeaway": "先观察，再比较；题目结论只在给定目标和条件下成立。"
        },
        {
          "id": "bad-shape",
          "title": "空三角、团子、棒形与重复",
          "text": "空三角常让气与空间重叠；团子和被逼成的长棒可能笨重。直线连接本身不是坏形，救棋、做眼或切断时紧凑形也可能必要。",
          "sceneId": "ADV-07-06",
          "takeaway": "先观察，再比较；题目结论只在给定目标和条件下成立。"
        }
      ],
      "guidedSceneIds": [
        "ADV-07-04"
      ],
      "sceneIds": [
        "ADV-07-01",
        "ADV-07-02",
        "ADV-07-03",
        "ADV-07-04",
        "ADV-07-05",
        "ADV-07-06"
      ],
      "summary": [
        "先说清目标，再比较效率。",
        "尖、飞、跳、虎是观察工具，不保证实连。",
        "空三角常偏集中；紧急时也可能必要。"
      ]
    },
    {
