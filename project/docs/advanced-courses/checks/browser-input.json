      "concepts": [
        {
          "id": "count",
          "title": "双方气、公气与外气",
          "text": "先列空点集合再取交集。黑独有、白独有、公气用文字和标记分别指出，不能重复算作同一块两口气。",
          "sceneId": "ADV-09-04",
          "takeaway": "先观察，再比较；题目结论只在给定目标和条件下成立。"
        },
        {
          "id": "turn",
          "title": "先手必须真的重算",
          "text": "同一布局黑先与白先分别合法重放，结论才有依据。",
          "sceneId": "ADV-09-03",
          "takeaway": "先观察，再比较；题目结论只在给定目标和条件下成立。"
        },
        {
          "id": "eyes",
          "title": "眼改变气的使用方式",
          "text": "受保护真眼不是普通外气。先看吃入是否合法，不引入复杂眼对杀公式。",
          "sceneId": "ADV-09-07",
          "takeaway": "先观察，再比较；题目结论只在给定目标和条件下成立。"
        }
