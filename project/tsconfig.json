{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "node"
    ]
  },
  "include": [
    "src",
    "tests",
    "scripts/*.ts",
    "vite.config.ts",
    "vite.engine.config.ts",
    "server",
    "vite.server.config.ts",
    "vite.analysis.config.ts"
  ],
  "exclude": [
    "scripts/engine-types-smoke.ts"
  ]
}
